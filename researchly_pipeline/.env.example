# researchly_pipeline environment (copy to your shell / CI secrets; the pipeline reads os.environ)

# Grounded LLM enrichment (default OFF). Reads each conference's own website; every value must quote the page.
ENABLE_LLM_ENRICHMENT=false
MAX_ENRICH_PER_RUN=50            # max new/stale websites fetched + sent to the LLM per run
ENRICH_RECHECK_DAYS=7            # cached sites are re-checked after this many days

# LLM key variable name: GEMINI_API_KEY. If unset, enrichment skips cleanly (no site is fetched).
GEMINI_API_KEY=
GEMINI_MODEL=                    # optional; default gemini-2.5-flash. Recorded in per-field provenance.
