PORT=5001

# Supabase (Dashboard -> Settings -> API). Leave blank to run in in-memory mode.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # backend only, never expose to the frontend

# LLM (used for post drafting / paper review only; it no longer creates conference data)
GEMINI_API_KEY=your-gemini-api-key

# Pipeline ingestion
INGEST_TOKEN=change-me-long-random-string          # required for POST /api/conferences/ingest
PIPELINE_OUTPUT_PATH=../researchly_pipeline/storage/output/conferences.json   # or PIPELINE_OUTPUT_URL=https://...
ENABLE_LIVE_CHECKS=false                           # true = DBLP + RDAP + OpenAlex (committee) lookups during audits
OPENALEX_MAILTO=                                   # optional contact email for OpenAlex's polite pool (sent as ?mailto=)
ENABLE_CURATED_SEED=true                           # false hides the unverified hand-entered seed list
CRON_INTERVAL_HOURS=12
