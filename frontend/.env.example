# Frontend Environment Variables Template
# Copy this file to .env and provide your project values.

# Supabase Authentication & Database Integration
# Retrieve these from: Supabase Project Settings -> API
# Format: https://<project-ref>.supabase.co
# IMPORTANT: Only use the Project URL and anon / publishable key. NEVER expose service_role key!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Or newer Supabase key naming convention:
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API Base URL (defaults to http://localhost:8000 if omitted)
VITE_API_BASE_URL=http://localhost:8000
