@@ -0,0 +1,60 @@
+name: ingest-conferences
+
+on:
+  schedule:
+    - cron: "17 */12 * * *"   # every 12 hours (GitHub schedules can lag by several minutes)
+  workflow_dispatch:
+
+jobs:
+  tests:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+          cache: pip
+          cache-dependency-path: researchly_pipeline/requirements.txt
+      - run: pip install -r researchly_pipeline/requirements.txt
+      - run: python -m pytest -q
+        working-directory: researchly_pipeline
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: backend/package-lock.json
+      - run: npm ci && npm test
+        working-directory: backend
+
+  ingest:
+    needs: tests
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+          cache: pip
+          cache-dependency-path: researchly_pipeline/requirements.txt
+      - run: pip install -r researchly_pipeline/requirements.txt
+      # Only sources with tos_reviewed: true in config/sources.yaml are crawled; others are skipped and reported.
+      - name: Run pipeline
+        working-directory: researchly_pipeline
+        run: python run.py --limit 100
+      - name: Push to backend
+        env:
+          BACKEND_URL: ${{ secrets.BACKEND_URL }}
+          INGEST_TOKEN: ${{ secrets.INGEST_TOKEN }}
+        run: |
+          OUT=researchly_pipeline/storage/output/conferences.json
+          if [ ! -s "$OUT" ]; then echo "No pipeline output (no reviewed sources?). Nothing to ingest."; exit 0; fi
+          curl -fsS --retry 3 --retry-delay 20 --max-time 180 -X POST "$BACKEND_URL/api/conferences/ingest" \
+            -H "content-type: application/json" -H "x-ingest-token: $INGEST_TOKEN" --data-binary @"$OUT"
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: pipeline-output
+          path: |
+            researchly_pipeline/storage/output/
+            researchly_pipeline/storage/failed/
+          if-no-files-found: ignore
